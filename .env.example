# Copiá este archivo a ".env" y completá tus claves reales.
# Nada de esto se sube a ningún repositorio público.

# --- Generación de guion (obligatorio para generación real) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Proveedor de imágenes ---
# "placeholder" = tarjetas gratis/offline (para probar el pipeline).
# "fal" = arte real con IA (fal.ai, modelos Flux), con consistencia de
# personaje entre escenas. Requiere FAL_KEY (fal.ai/dashboard/keys) y
# PUBLIC_BASE_URL (para que fal.ai pueda descargar las fotos que suben los
# usuarios). Ver docs/arquitectura-tecnica.md sección "Generación de imágenes".
IMAGE_PROVIDER=placeholder
FAL_KEY=

# --- Proveedor de voz / TTS ---
# "placeholder" = voz robótica en inglés, gratis/offline (para probar el pipeline).
# "openai" = voz real en español (gpt-4o-mini-tts, ~US$0.015/min). Requiere
# OPENAI_API_KEY (platform.openai.com/api-keys).
TTS_PROVIDER=placeholder
OPENAI_API_KEY=
# Voz de OpenAI a usar (opcional). Por defecto "coral" (cálida). Otras
# opciones: alloy, ash, ballad, echo, fable, onyx, nova, sage, shimmer.
TTS_VOICE=coral

# --- URL pública del sitio, tal cual la ve internet ---
# Necesaria para IMAGE_PROVIDER=fal (para resolver las fotos de personajes
# que suben los usuarios en /uploads a una URL absoluta). En Render es la
# URL que te asigna, por ejemplo: https://mi-serie-magica.onrender.com
PUBLIC_BASE_URL=

PORT=3000
