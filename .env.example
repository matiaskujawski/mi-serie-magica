# Copiá este archivo a ".env" y completá tus claves reales.
# Nada de esto se sube a ningún repositorio público.

# --- Generación de guion (obligatorio para generación real) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Proveedor de imágenes (opcional mientras se usa el modo "placeholder") ---
# Opciones sugeridas para producción: fal.ai (Flux), getimg.ai (Elements),
# OpenAI Images, Replicate. Ver docs/arquitectura-tecnica.md sección "Costos".
IMAGE_PROVIDER=placeholder
IMAGE_PROVIDER_API_KEY=

# --- Proveedor de voz / TTS (opcional mientras se usa el modo "placeholder") ---
# Opciones sugeridas: OpenAI gpt-4o-mini-tts (más barato), Google Cloud TTS,
# Azure Neural TTS, ElevenLabs (mejor calidad emocional, más caro).
TTS_PROVIDER=placeholder
TTS_PROVIDER_API_KEY=

PORT=3000
